---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'PxeLab — All-in-one PXE Server',
  description = 'All-in-one PXE server with a modern web UI. DHCP, TFTP, HTTP, DNS, NFS — one binary, zero dependencies.',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/i18n.js';
      import '../scripts/main.js';
    </script>
  </body>
</html>
